# =============================================================================
# Killer Sudoku — Beispiel-Umgebungs-Variablen für docker compose
# Kopieren nach .env und Werte anpassen (.env ist gitignored).
# =============================================================================

# MS-SQL SA-Password — muss MS-SQL Strong-Password-Policy erfüllen
# (>= 8 Zeichen, drei der vier Kategorien: Upper, Lower, Digit, Symbol).
# Bitte ändern, NICHT in Produktion verwenden.
MSSQL_SA_PASSWORD=ReplaceWithStrongPass!2026
